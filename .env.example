# قاعدة PostgreSQL خارج Railway (Supabase/Neon مثلاً) - الأفضل لحفظ البيانات عند نقل الحساب
DATABASE_URL=
# اتركها فارغة غالبًا؛ استخدم disable فقط لو قاعدة البيانات لا تستخدم SSL
PGSSLMODE=

FIVEM_STATUS_SECRET=
# FIVEM_JOIN_URL=https://cfx.re/join/YOUR_CODE

# Gemini: add the real key in Railway Variables only. Never commit it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_DAILY_LIMIT=20

# OMEN website is integrated into this same service under /omen.
# Reuses the Discord credentials and SESSION_SECRET above. No new token required.
# Optional website reviewers (channel buttons remain available to channel viewers):
# OMEN_REVIEWER_IDS=
# Optional FiveM queue bridge secret, shared with the FiveM resource:
# OMEN_BRIDGE_SECRET=
